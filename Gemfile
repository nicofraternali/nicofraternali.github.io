source "https://rubygems.org"

gem "jekyll", "~> 4.4"

group :jekyll_plugins do
  gem "jekyll-feed"
  gem "jekyll-seo-tag"
  gem "jekyll-sitemap"
  gem "jektex"
end

# Windows has no zoneinfo database and needs a file watcher shim.
platforms :windows, :jruby do
  gem "tzinfo-data"
  gem "wdm", ">= 0.1.0"
end
